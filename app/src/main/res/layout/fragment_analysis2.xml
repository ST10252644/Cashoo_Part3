<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">
    <!--(AndroidDevelopers, 2023), (Kay, 2022), (Coder, 2022), (Coder, 2024)-->
    <!-- Main scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--(Technology, 2020), (GeeksforGeeks, 2024)-->
            <!-- Fragment container for MonthlySummaryFragment -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:defaultNavHost="true"
                app:navGraph="@navigation/mobile_navigation"
                tools:fragment=".graphs.MonthlySummaryFragment" />

            <!-- Section for the graphs -->
            <LinearLayout
                android:id="@+id/bar_graph_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">

                <!-- Title -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="@drawable/rounded_background"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Income and Expenses"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />
                </LinearLayout>
                <!--(AndroidDevelopers, 2023), (Kay, 2022), (Coder, 2022), (Coder, 2024)-->

                <!-- Pie Chart for total expenses -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="24dp" />

                <!-- Dynamic layout for category breakdown -->
                <LinearLayout
                    android:id="@+id/detailsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp"
                    android:paddingHorizontal="8dp">

                    <!-- Static heading row (gets removed in code, replaced programmatically) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/text_heading"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Amount"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/text_heading"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/text_heading"
                            android:textSize="16sp"
                            android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
                <!--(Technology, 2020), (GeeksforGeeks, 2024)-->
                <!-- Income and Expense visual block -->
                <LinearLayout
                    android:id="@+id/incomeExpenseSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="50dp"
                    android:gravity="center">

                    <!-- Income block -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/income" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Income"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:id="@+id/incomeAmountTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R4,120.00"
                            android:textColor="@color/income"
                            android:textSize="23sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Expense block -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/outcome" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expense"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:id="@+id/expenseAmountTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R1,187.40"
                            android:textColor="@color/outcome"
                            android:textSize="23sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Section header -->
                <LinearLayout
                    android:id="@+id/curvedCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/rounded_background"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/pageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Category Expense"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/text_heading"
                        android:textSize="16sp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Tab selector for bar chart -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    app:tabBackground="@drawable/tab_background"
                    app:tabIndicatorHeight="0dp"
                    app:tabSelectedTextColor="@android:color/black"
                    app:tabTextColor="#808080" />

                <!-- Bar chart for weekly/monthly/yearly data -->
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="20dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
