<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qrmain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <!-- Title -->
        <TextView
            android:id="@+id/qrTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan QR code"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />


        <TextView
            android:id="@+id/qrLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan this QR code in-app to verify a device."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <!-- QR Image -->
        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="20dp"
            android:scaleType="centerInside"
            android:contentDescription="QR Image" />


        <TextView
            android:id="@+id/qrDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="28 May 2025 at 20:24"
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_marginBottom="20dp" />


        <ImageView
            android:id="@+id/qrCodeImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="QR Code"
            android:background="@drawable/bg_qr_border" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or enter the code manually"
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_marginBottom="8dp" />

        <!-- Voucher Code -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_code_input"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/qrVoucherCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HLA8G4LI..."
            android:textSize="16sp"
            android:textColor="#333333"
            android:maxLines="1" />
        </LinearLayout>

        <!-- Confirm Button  -->
        <Button
            android:id="@+id/qrConfirmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1DAA52"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
